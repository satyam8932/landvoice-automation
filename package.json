{
  "name": "landvoice-csv-exporter",
  "version": "0.1.0",
  "description": "Logs into Landvoice accounts and exports lead CSVs. Built to be called from n8n.",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "local": "npm run build && apify run --purge"
  },
  "dependencies": {
    "apify": "^3.2.6",
    "playwright": "1.64.1"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
