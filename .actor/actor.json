{
  "actorSpecification": 1,
  "name": "landvoice-csv-exporter",
  "title": "Landvoice CSV Exporter",
  "description": "Logs into one or more Landvoice accounts and exports lead CSVs when entries exist.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "input": "./input_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Results",
          "transformation": {
            "fields": [
              "email",
              "label",
              "status",
              "errorCode",
              "errorMessage",
              "isExportExpireds",
              "expiredsCount",
              "expiredsCsvUrl",
              "isExportFsbo",
              "fsboCount",
              "fsboCsvUrl",
              "isExportPreforeclosure",
              "preforeclosureCount",
              "preforeclosureCsvUrl",
              "attempts",
              "durationMs",
              "finishedAt"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "expiredsCsvUrl": {
                "label": "expireds CSV",
                "format": "link"
              },
              "fsboCsvUrl": {
                "label": "fsbo CSV",
                "format": "link"
              },
              "preforeclosureCsvUrl": {
                "label": "preforeclosure CSV",
                "format": "link"
              }
            }
          }
        }
      }
    }
  },
  "defaultMemoryMbytes": 2048,
  "maxMemoryMbytes": 2048
}
