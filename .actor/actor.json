{
  "actorSpecification": 1,
  "name": "landvoice-csv-exporter",
  "title": "Landvoice CSV Exporter",
  "description": "Logs into one or more Landvoice accounts and exports lead CSVs when entries exist.",
  "version": "0.1",
  "buildTag": "latest",
  "dockerfile": "./Dockerfile",
  "input": "./input_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "overview": {
          "title": "Results",
          "transformation": {
            "fields": [
              "email",
              "label",
              "status",
              "errorCode",
              "errorMessage",
              "attempts",
              "durationMs"
            ]
          },
          "display": {
            "component": "table",
            "properties": {}
          }
        }
      }
    }
  }
}
