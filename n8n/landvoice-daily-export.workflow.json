        "jsCode": "// One Run Log row per account, even if the sub-workflow crashed for that account.\nconst sent = $('Batch Finished?').all(); // same order as the sub-workflow results\n\nreturn $input.all().map((out, i) => {\n  // Rebuild the item: sub-workflow results carry extra keys (e.g. metadata) n8n rejects in Code output.\n  if (out.json.Status) return { json: out.json };\n  const run = sent[i]?.json ?? {};\n  return {\n    json: {\n      'Run Date': $now.toFormat('yyyy-MM-dd HH:mm'),\n      'Client Name': run.clientName ?? '',\n      'Email': run.email ?? '',\n      'Status': 'SAVE_FAILED',\n      'Error': `Saving exports failed: ${out.json.error?.message ?? JSON.stringify(out.json)}`,\n      'Expireds': '',\n      'FSBO': '',\n      'Pre-Foreclosure': '',\n      'Drive Folder': '',\n      'Google Sheets': '',\n      'Apify Run': run.runId ? `https://console.apify.com/view/runs/${run.runId}` : '',\n    },\n  };\n});\n"
      },
