    {
      "parameters": {
        "jsCode": "// Merges each run's latest Apify status into its tracking item and decides if the whole batch is done.\n// The batch is done when no run is READY/RUNNING (or a status call keeps failing) - or maxPolls is hit.\nconst { maxPolls } = $('Config').first().json;\nconst ACTIVE = ['READY', 'RUNNING', 'POLL_ERROR'];\nconst sent = $('Wait').all(); // same order as the status responses\n\nconst runs = $input.all().map((res, i) => {\n  const prev = sent[i].json;\n  const data = res.json.data;\n  return {\n    ...prev,\n    status: data?.status ?? 'POLL_ERROR',\n    statusMessage: data?.statusMessage ?? res.json.error?.message ?? '',\n    polls: (prev.polls ?? 0) + 1,\n  };\n});\n\nconst pending = runs.filter((r) => ACTIVE.includes(r.status) && r.polls < maxPolls);\nconst batchDone = pending.length === 0;\n\nreturn runs.map((r) => ({\n  json: {\n    ...r,\n    // Runs still active after maxPolls are reported instead of polled forever.\n    status: batchDone && ACTIVE.includes(r.status) ? 'POLL_TIMEOUT' : r.status,\n    batchDone,\n  },\n}));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3120,
        100
      ],
      "id": "8a84d831-a6e8-4686-87af-b9166b9c6d79",
      "name": "Check Batch",
      "notes": "All runs finished?",
      "notesInFlow": true
    },
