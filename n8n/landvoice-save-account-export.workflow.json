              "id": "2628731c-e0f7-4e85-bba9-637d683e31a4",
              "leftValue": "={{ ($json.files || []).length }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
