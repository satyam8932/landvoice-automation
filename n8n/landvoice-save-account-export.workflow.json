        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        -220
      ],
      "id": "1e99c91f-5301-4534-a0d1-9251b9134271",
      "name": "Client Folder Exists?",
      "notes": "Found one?",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/drive/v3/files?supportsAllDrives=true&fields=id,name,webViewLink",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $('When Called by Daily Export').first().json.clientName, mimeType: 'application/vnd.google-apps.folder', parents: [$('When Called by Daily Export').first().json.dateFolderId] }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -80
      ],
      "id": "13f69b75-1fd3-4ddc-b947-b87f27e039c6",
      "name": "Create Client Folder",
      "notes": "New folder",
      "notesInFlow": true,
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// One output item per list that produced a CSV (Expireds / FSBO / Pre-Foreclosure).\n// File name: \"<Client Name> - <List> - <export date>\" so a sheet is self-describing even outside its folder.\nconst LIST_TITLES = { expireds: 'Expireds', fsbo: 'FSBO', preforeclosure: 'Pre-Foreclosure' };\n\nconst ctx = $('When Called by Daily Export').first().json;\nconst result = $('Get Run Result').first().json;\nconst folderId = $('Create Client Folder').isExecuted\n  ? $('Create Client Folder').first().json.id\n  : $('Find Client Folder').first().json.files[0].id;\n\nreturn Object.entries(LIST_TITLES)\n  .filter(([list]) => result[`${list}CsvUrl`])\n  .map(([list, title]) => ({\n    json: {\n      list,\n      fileName: `${ctx.clientName} - ${title} - ${ctx.exportDate}`,\n      csvUrl: result[`${list}CsvUrl`],\n      entries: result[`${list}Count`],\n      folderId,\n    },\n  }));\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -220
      ],
      "id": "74306147-2803-4ed2-8092-8ce992b90b26",
      "name": "Prepare Files",
      "notes": "1 item per exported list",
      "notesInFlow": true
    },
    {
      "parameters": {
        "url": "={{ $json.csvUrl }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "csvText"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        -220
      ],
      "id": "ab53f332-e98f-4b57-8b54-37641474801f",
      "name": "Download CSV",
      "notes": "Signed Apify URL, no auth",
      "notesInFlow": true,
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Drive \"multipart/related\" upload body: JSON metadata + the CSV.\n// mimeType google-apps.spreadsheet makes Drive convert the CSV into a native Google Sheet.\nconst file = $('Prepare Files').item.json;\nif ($json.error) return { json: { ...file, error: $json.error } };\n\nconst boundary = 'landvoice_csv_boundary';\nconst metadata = { name: file.fileName, mimeType: 'application/vnd.google-apps.spreadsheet', parents: [file.folderId] };\nconst uploadBody = [\n  `--${boundary}`,\n  'Content-Type: application/json; charset=UTF-8',\n  '',\n  JSON.stringify(metadata),\n  `--${boundary}`,\n  'Content-Type: text/csv; charset=UTF-8',\n  '',\n  $json.csvText,\n  `--${boundary}--`,\n].join('\\r\\n');\n\nreturn { json: { ...file, uploadBody } };\n",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        -220
      ],
      "id": "6c06820d-a5a4-4d12-b727-483857b58949",
      "name": "Build Upload Body",
      "notes": "Metadata + CSV payload",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://www.googleapis.com/upload/drive/v3/files?uploadType=multipart&supportsAllDrives=true&fields=id,name,webViewLink",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleDriveOAuth2Api",
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "multipart/related; boundary=landvoice_csv_boundary",
        "body": "={{ $json.uploadBody }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        -220
      ],
      "id": "ed4f43b6-98a6-40cf-813d-e51fc604b0d9",
      "name": "Upload as Google Sheet",
      "notes": "Drive API, converts to Sheet",
      "notesInFlow": true,
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Always returns exactly one Run Log row; this is what the parent workflow receives.\n// Reached from: Run Succeeded? (false), Has Exports? (false) or Upload as Google Sheet.\nconst ctx = $('When Called by Daily Export').first().json;\nconst items = $input.all().map((i) => i.json);\nconst result = $('Get Run Result').isExecuted ? $('Get Run Result').first().json ?? {} : {};\nconst errors = [];\nlet status;\n\nif (ctx.status !== 'SUCCEEDED') {\n  status = `RUN_${ctx.status}`;\n  if (ctx.statusMessage) errors.push(ctx.statusMessage);\n} else {\n  status = result.status ?? 'NO_RESULT';\n  if (result.errorCode) errors.push(`${result.errorCode}: ${result.errorMessage}`);\n}\n\n// Upload responses line up 1:1 with the upload bodies, which carry the file names.\nconst bodies = $('Build Upload Body').isExecuted ? $('Build Upload Body').all().map((i) => i.json) : [];\nconst sheets = items.filter((i) => i.webViewLink);\nitems.forEach((item, i) => {\n  if (item.error) errors.push(`Upload failed for ${bodies[i]?.fileName ?? 'a file'}: ${item.error.message ?? JSON.stringify(item.error)}`);\n});\n\nconst folderId = $('Prepare Files').isExecuted ? $('Prepare Files').first().json.folderId : null;\nconst count = (list) => result[`${list}Count`] ?? '';\n\nreturn [{\n  json: {\n    'Run Date': $now.toFormat('yyyy-MM-dd HH:mm'),\n    'Client Name': ctx.clientName,\n    'Email': ctx.email,\n    'Status': status,\n    'Error': errors.join(' | '),\n    'Expireds': count('expireds'),\n    'FSBO': count('fsbo'),\n    'Pre-Foreclosure': count('preforeclosure'),\n    'Drive Folder': folderId ? `https://drive.google.com/drive/folders/${folderId}` : '',\n    'Google Sheets': sheets.map((s) => `${s.name}: ${s.webViewLink}`).join('\\n'),\n    'Apify Run': `https://console.apify.com/view/runs/${ctx.runId}`,\n  },\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2440,
        0
      ],
      "id": "b4b0b519-2204-4d58-9f80-b40bfec7ec37",
      "name": "Build Run Log Row",
      "notes": "1 row, returned to parent",
      "notesInFlow": true
    }
  ],
